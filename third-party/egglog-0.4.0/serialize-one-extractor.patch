+/// One extractor per `serialize` call.  Printing a primitive value goes
+/// through an `Extractor`, whose construction computes costs over the whole
+/// e-graph; upstream built a fresh one for every primitive node, which made
+/// serialization quadratic in the size of the e-graph.
+struct SerializeExtractor<'a> {
+    extractor: Extractor<'a>,
+    termdag: TermDag,
+}
+
+impl<'a> SerializeExtractor<'a> {
+    fn new(egraph: &'a EGraph) -> Self {
+        let mut termdag = TermDag::default();
+        let extractor = Extractor::new(egraph, &mut termdag);
+        SerializeExtractor { extractor, termdag }
+    }
+}
