(constructor @< (Term) Term)
(constructor @<= (Term) Term)
(constructor @> (Term) Term)
(constructor @>= (Term) Term)

(constructor EqRelKey (PolyN) Term)
(constructor GeqKey (PolyN) Term)
(constructor GtKey (PolyN) Term)
(constructor LeqKey (PolyN) Term)
(constructor LtKey (PolyN) Term)

(relation arithPolyNormRelDiff (Term Term Term))

(function arithPolyNormRelCoeff (Term) BigRat :no-merge)
(relation arithPolyNormRelCoeff-demand (Term))

(function atomHashIsInt (i64) bool :merge old)

(function monIsIntN (MonN) bool :no-merge)
(relation monIsIntN-demand (MonN))

(function polyIsIntExprN (PolyN) bool :no-merge)
(relation polyIsIntExprN-demand (PolyN))

(function relConstN (PolyN) BigRat :no-merge)
(relation relConstN-demand (PolyN))

(function relRestN (PolyN) PolyN :no-merge)
(relation relRestN-demand (PolyN))

(function relScaleAbsN (PolyN) BigRat :no-merge)
(relation relScaleAbsN-demand (PolyN))

(function canonRelPolyN (PolyN) PolyN :no-merge)
(relation canonRelPolyN-demand (PolyN))

(function canonGeqPolyN (PolyN) PolyN :no-merge)
(relation canonGeqPolyN-demand (PolyN))

(function canonEqPolyN (PolyN) PolyN :no-merge)
(relation canonEqPolyN-demand (PolyN))

(function relPolyOf (Term) PolyN :merge old)
(relation relPolyOf-demand (Term))

(function eqRelPolyOf (Term) PolyN :merge old)
(relation eqRelPolyOf-demand (Term))

(rule
  ((= dx (Mk (@- (Args x1 (Args x2 (Empty)))))))
  ((arithPolyNormRelDiff dx x1 x2))
  :ruleset arith_poly)

(rule
  ((= dx
      (Mk (@to_real (Args (Mk (@- (Args x1 (Args x2 (Empty))))) (Empty))))))
  ((arithPolyNormRelDiff dx x1 x2))
  :ruleset arith_poly)

(rule
  ((arithPolyNormRelCoeff-demand (Mk (Num i))))
  ((set (arithPolyNormRelCoeff (Mk (Num i)))
        (bigrat (bigint i) (bigint 1))))
  :ruleset arith_poly)

(rule
  ((arithPolyNormRelCoeff-demand (Mk (Real n d))))
  ((set (arithPolyNormRelCoeff (Mk (Real n d)))
        (bigrat (bigint n) (bigint d))))
  :ruleset arith_poly)

(rule
  ((arithPolyNormRelCoeff-demand (Mk (RatConst q))))
  ((set (arithPolyNormRelCoeff (Mk (RatConst q))) q))
  :ruleset arith_poly)

(rule
  ((atomMonN-demand (Mk (Var x int_sort))))
  ((set (atomHashIsInt (arith_poly_atom_hash (Mk (Var x int_sort)))) true))
  :ruleset arith_poly)

(rule
  ((atomMonN-demand (Mk (Var x real_sort))))
  ((set (atomHashIsInt (arith_poly_atom_hash (Mk (Var x real_sort)))) false))
  :ruleset arith_poly)

(rule
  ((atomMonN-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (atomHashIsInt
         (arith_poly_atom_hash (Mk (@/ (Args t (Args d (Empty)))))))
        false))
  :ruleset arith_poly)

(rule
  ((atomMonN-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (atomHashIsInt
         (arith_poly_atom_hash (Mk (@/_total (Args t (Args d (Empty)))))))
        false))
  :ruleset arith_poly)

(rule
  ((monIsIntN-demand (MOne)))
  ((set (monIsIntN (MOne)) true))
  :ruleset arith_poly)

(rule
  ((monIsIntN-demand (MCons h t)))
  ((monIsIntN-demand t))
  :ruleset arith_poly)

(rule
  ((= (atomHashIsInt h) false)
   (monIsIntN-demand (MCons h t)))
  ((set (monIsIntN (MCons h t)) false))
  :ruleset arith_poly)

(rule
  ((= (atomHashIsInt h) true)
   (= (monIsIntN t) false)
   (monIsIntN-demand (MCons h t)))
  ((set (monIsIntN (MCons h t)) false))
  :ruleset arith_poly)

(rule
  ((= (atomHashIsInt h) true)
   (= (monIsIntN t) true)
   (monIsIntN-demand (MCons h t)))
  ((set (monIsIntN (MCons h t)) true))
  :ruleset arith_poly)

(rule
  ((polyIsIntExprN-demand (PZero)))
  ((set (polyIsIntExprN (PZero)) true))
  :ruleset arith_poly)

(rule
  ((polyIsIntExprN-demand (PCons (MOne) c rest)))
  ((polyIsIntExprN-demand rest))
  :ruleset arith_poly)

(rule
  ((= (polyIsIntExprN rest) ok)
   (polyIsIntExprN-demand (PCons (MOne) c rest)))
  ((set (polyIsIntExprN (PCons (MOne) c rest)) ok))
  :ruleset arith_poly)

(rule
  ((polyIsIntExprN-demand (PCons m c rest))
   (!= m (MOne)))
  ((monIsIntN-demand m)
   (polyIsIntExprN-demand rest))
  :ruleset arith_poly)

(rule
  ((= (denom c) (bigint 1))
   (= (monIsIntN m) true)
   (= (polyIsIntExprN rest) true)
   (polyIsIntExprN-demand (PCons m c rest))
   (!= m (MOne)))
  ((set (polyIsIntExprN (PCons m c rest)) true))
  :ruleset arith_poly)

(rule
  ((polyIsIntExprN-demand (PCons m c rest))
   (!= m (MOne))
   (!= (denom c) (bigint 1)))
  ((set (polyIsIntExprN (PCons m c rest)) false))
  :ruleset arith_poly)

(rule
  ((= (denom c) (bigint 1))
   (= (monIsIntN m) false)
   (polyIsIntExprN-demand (PCons m c rest))
   (!= m (MOne)))
  ((set (polyIsIntExprN (PCons m c rest)) false))
  :ruleset arith_poly)

(rule
  ((= (denom c) (bigint 1))
   (= (monIsIntN m) true)
   (= (polyIsIntExprN rest) false)
   (polyIsIntExprN-demand (PCons m c rest))
   (!= m (MOne)))
  ((set (polyIsIntExprN (PCons m c rest)) false))
  :ruleset arith_poly)

(rule
  ((relConstN-demand (PZero)))
  ((set (relConstN (PZero)) rat_zero))
  :ruleset arith_poly)

(rule
  ((relConstN-demand (PCons (MOne) c rest)))
  ((set (relConstN (PCons (MOne) c rest)) c))
  :ruleset arith_poly)

(rule
  ((relConstN-demand (PCons m c rest))
   (!= m (MOne)))
  ((set (relConstN (PCons m c rest)) rat_zero))
  :ruleset arith_poly)

(rule
  ((relRestN-demand (PZero)))
  ((set (relRestN (PZero)) (PZero)))
  :ruleset arith_poly)

(rule
  ((relRestN-demand (PCons (MOne) c rest)))
  ((set (relRestN (PCons (MOne) c rest)) rest))
  :ruleset arith_poly)

(rule
  ((relRestN-demand (PCons m c rest))
   (!= m (MOne)))
  ((set (relRestN (PCons m c rest)) (PCons m c rest)))
  :ruleset arith_poly)

(rule
  ((relScaleAbsN-demand (PZero)))
  ((set (relScaleAbsN (PZero)) rat_zero))
  :ruleset arith_poly)

(rule
  ((relScaleAbsN-demand (PCons m c rest))
   (!= m (MOne))
   (< c rat_zero))
  ((set (relScaleAbsN (PCons m c rest)) (* rat_neg_one c)))
  :ruleset arith_poly)

(rule
  ((relScaleAbsN-demand (PCons m c rest))
   (!= m (MOne))
   (>= c rat_zero))
  ((set (relScaleAbsN (PCons m c rest)) c))
  :ruleset arith_poly)

(rule
  ((relScaleAbsN-demand (PCons (MOne) c rest))
   (!= rest (PZero)))
  ((relScaleAbsN-demand rest))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN rest) s)
   (relScaleAbsN-demand (PCons (MOne) c rest))
   (!= rest (PZero)))
  ((set (relScaleAbsN (PCons (MOne) c rest)) s))
  :ruleset arith_poly)

(rule
  ((relScaleAbsN-demand (PCons (MOne) c (PZero)))
   (< c rat_zero))
  ((set (relScaleAbsN (PCons (MOne) c (PZero))) (* rat_neg_one c)))
  :ruleset arith_poly)

(rule
  ((relScaleAbsN-demand (PCons (MOne) c (PZero)))
   (>= c rat_zero))
  ((set (relScaleAbsN (PCons (MOne) c (PZero))) c))
  :ruleset arith_poly)

(rule
  ((canonRelPolyN-demand p))
  ((relScaleAbsN-demand p))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN p) rat_zero)
   (canonRelPolyN-demand p))
  ((set (canonRelPolyN p) p))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN p) k)
   (!= k rat_zero)
   (canonRelPolyN-demand p))
  ((scalePolyN-demand (/ rat_one k) p))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN p) k)
   (!= k rat_zero)
   (= (scalePolyN (/ rat_one k) p) s)
   (canonRelPolyN-demand p))
  ((set (canonRelPolyN p) s))
  :ruleset arith_poly)

(rule
  ((canonGeqPolyN-demand p))
  ((canonRelPolyN-demand p))
  :ruleset arith_poly)

(rule
  ((= (canonRelPolyN p) s)
   (canonGeqPolyN-demand p))
  ((relRestN-demand s)
   (relConstN-demand s))
  :ruleset arith_poly)

(rule
  ((= (canonRelPolyN p) s)
   (= (relRestN s) rest)
   (canonGeqPolyN-demand p))
  ((polyIsIntExprN-demand rest))
  :ruleset arith_poly)

(rule
  ((= (canonRelPolyN p) s)
   (= (relRestN s) rest)
   (= (polyIsIntExprN rest) false)
   (canonGeqPolyN-demand p))
  ((set (canonGeqPolyN p) s))
  :ruleset arith_poly)

(rule
  ((= (canonRelPolyN p) s)
   (= (relRestN s) rest)
   (= (polyIsIntExprN rest) true)
   (= (relConstN s) k)
   (= (* rat_neg_one (ceil (* rat_neg_one k))) rat_zero)
   (canonGeqPolyN-demand p))
  ((set (canonGeqPolyN p) rest))
  :ruleset arith_poly)

(rule
  ((= (canonRelPolyN p) s)
   (= (relRestN s) rest)
   (= (polyIsIntExprN rest) true)
   (= (relConstN s) k)
   (!= (* rat_neg_one (ceil (* rat_neg_one k))) rat_zero)
   (canonGeqPolyN-demand p))
  ((addPolyN-demand
    (PCons (MOne) (* rat_neg_one (ceil (* rat_neg_one k))) (PZero))
    rest))
  :ruleset arith_poly)

(rule
  ((= (canonRelPolyN p) s)
   (= (relRestN s) rest)
   (= (polyIsIntExprN rest) true)
   (= (relConstN s) k)
   (!= (* rat_neg_one (ceil (* rat_neg_one k))) rat_zero)
   (= (addPolyN
       (PCons (MOne) (* rat_neg_one (ceil (* rat_neg_one k))) (PZero))
       rest)
      out)
   (canonGeqPolyN-demand p))
  ((set (canonGeqPolyN p) out))
  :ruleset arith_poly)

(rule
  ((canonEqPolyN-demand (PZero)))
  ((set (canonEqPolyN (PZero)) (PZero)))
  :ruleset arith_poly)

(rule
  ((canonEqPolyN-demand (PCons m c rest)))
  ((relScaleAbsN-demand (PCons m c rest)))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN (PCons m c rest)) k)
   (>= c rat_zero)
   (canonEqPolyN-demand (PCons m c rest)))
  ((scalePolyN-demand (/ rat_one k) (PCons m c rest)))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN (PCons m c rest)) k)
   (>= c rat_zero)
   (= (scalePolyN (/ rat_one k) (PCons m c rest)) s)
   (canonEqPolyN-demand (PCons m c rest)))
  ((set (canonEqPolyN (PCons m c rest)) s))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN (PCons m c rest)) k)
   (< c rat_zero)
   (canonEqPolyN-demand (PCons m c rest)))
  ((scalePolyN-demand (/ rat_neg_one k) (PCons m c rest)))
  :ruleset arith_poly)

(rule
  ((= (relScaleAbsN (PCons m c rest)) k)
   (< c rat_zero)
   (= (scalePolyN (/ rat_neg_one k) (PCons m c rest)) s)
   (canonEqPolyN-demand (PCons m c rest)))
  ((set (canonEqPolyN (PCons m c rest)) s))
  :ruleset arith_poly)

;; Equality atoms are canonicalized through the normalized difference `lhs - rhs`,
;; up to any nonzero scalar multiple.
(rule
  ((= lhs (Mk (@= (Args x1 (Args x2 (Empty)))))))
  ((eqRelPolyOf-demand lhs))
  :ruleset arith_poly)

(rule
  ((eqRelPolyOf-demand (Mk (@= (Args x1 (Args x2 (Empty)))))))
  ((arithPolyNfOf-demand (Mk (@- (Args x1 (Args x2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((eqRelPolyOf-demand (Mk (@= (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x1 (Args x2 (Empty)))))) diff))
  ((canonEqPolyN-demand diff))
  :ruleset arith_poly)

(rule
  ((eqRelPolyOf-demand (Mk (@= (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x1 (Args x2 (Empty)))))) diff)
   (= (canonEqPolyN diff) canon))
  ((set (eqRelPolyOf (Mk (@= (Args x1 (Args x2 (Empty)))))) canon))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@= (Args x1 (Args x2 (Empty))))))
   (= (eqRelPolyOf lhs) canon))
  ((union lhs (EqRelKey canon)))
  :ruleset arith_poly)

;; Order relations are canonicalized through their normalized difference,
;; up to positive scaling only.
(rule
  ((= lhs (Mk (@>= (Args x1 (Args x2 (Empty)))))))
  ((relPolyOf-demand lhs))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@>= (Args x1 (Args x2 (Empty)))))))
  ((arithPolyNfOf-demand (Mk (@- (Args x1 (Args x2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@>= (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x1 (Args x2 (Empty)))))) diff))
  ((canonGeqPolyN-demand diff))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@>= (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x1 (Args x2 (Empty)))))) diff)
   (= (canonGeqPolyN diff) canon))
  ((set (relPolyOf (Mk (@>= (Args x1 (Args x2 (Empty)))))) canon))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@>= (Args x1 (Args x2 (Empty))))))
   (= (relPolyOf lhs) canon))
  ((union lhs (GeqKey canon)))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@> (Args x1 (Args x2 (Empty)))))))
  ((relPolyOf-demand lhs))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@> (Args x1 (Args x2 (Empty)))))))
  ((arithPolyNfOf-demand (Mk (@- (Args x1 (Args x2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@> (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x1 (Args x2 (Empty)))))) diff))
  ((canonRelPolyN-demand diff))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@> (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x1 (Args x2 (Empty)))))) diff)
   (= (canonRelPolyN diff) canon))
  ((set (relPolyOf (Mk (@> (Args x1 (Args x2 (Empty)))))) canon))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@> (Args x1 (Args x2 (Empty))))))
   (= (relPolyOf lhs) canon))
  ((union lhs (GtKey canon)))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@<= (Args x1 (Args x2 (Empty)))))))
  ((relPolyOf-demand lhs))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@<= (Args x1 (Args x2 (Empty)))))))
  ((arithPolyNfOf-demand (Mk (@- (Args x2 (Args x1 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@<= (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x2 (Args x1 (Empty)))))) diff))
  ((canonGeqPolyN-demand diff))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@<= (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x2 (Args x1 (Empty)))))) diff)
   (= (canonGeqPolyN diff) canon))
  ((set (relPolyOf (Mk (@<= (Args x1 (Args x2 (Empty)))))) canon))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@<= (Args x1 (Args x2 (Empty))))))
   (= (relPolyOf lhs) canon))
  ((union lhs (LeqKey canon)))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@< (Args x1 (Args x2 (Empty)))))))
  ((relPolyOf-demand lhs))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@< (Args x1 (Args x2 (Empty)))))))
  ((arithPolyNfOf-demand (Mk (@- (Args x2 (Args x1 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@< (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x2 (Args x1 (Empty)))))) diff))
  ((canonRelPolyN-demand diff))
  :ruleset arith_poly)

(rule
  ((relPolyOf-demand (Mk (@< (Args x1 (Args x2 (Empty))))))
   (= (arithPolyNfOf (Mk (@- (Args x2 (Args x1 (Empty)))))) diff)
   (= (canonRelPolyN diff) canon))
  ((set (relPolyOf (Mk (@< (Args x1 (Args x2 (Empty)))))) canon))
  :ruleset arith_poly)

(rule
  ((= lhs (Mk (@< (Args x1 (Args x2 (Empty))))))
   (= (relPolyOf lhs) canon))
  ((union lhs (LtKey canon)))
  :ruleset arith_poly)

;; Premises of the shape `cx * dx = cy * dy` lift relation facts when `dx`
;; and `dy` are normalized differences of relation arguments.
(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty)))))))
  ((arithPolyNormRelCoeff-demand cx)
   (arithPolyNormRelCoeff-demand cy))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2))
  ((union (Mk (@= (Args x1 (Args x2 (Empty)))))
          (Mk (@= (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< rat_zero kx)
   (< rat_zero ky))
  ((union (Mk (@< (Args x1 (Args x2 (Empty)))))
          (Mk (@< (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< kx rat_zero)
   (< ky rat_zero))
  ((union (Mk (@< (Args x1 (Args x2 (Empty)))))
          (Mk (@< (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< rat_zero kx)
   (< rat_zero ky))
  ((union (Mk (@<= (Args x1 (Args x2 (Empty)))))
          (Mk (@<= (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< kx rat_zero)
   (< ky rat_zero))
  ((union (Mk (@<= (Args x1 (Args x2 (Empty)))))
          (Mk (@<= (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< rat_zero kx)
   (< rat_zero ky))
  ((union (Mk (@> (Args x1 (Args x2 (Empty)))))
          (Mk (@> (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< kx rat_zero)
   (< ky rat_zero))
  ((union (Mk (@> (Args x1 (Args x2 (Empty)))))
          (Mk (@> (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< rat_zero kx)
   (< rat_zero ky))
  ((union (Mk (@>= (Args x1 (Args x2 (Empty)))))
          (Mk (@>= (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (Mk (@* (Args cx (Args dx (Empty)))))
      (Mk (@* (Args cy (Args dy (Empty))))))
   (arithPolyNormRelDiff dx x1 x2)
   (arithPolyNormRelDiff dy y1 y2)
   (= (arithPolyNormRelCoeff cx) kx)
   (= (arithPolyNormRelCoeff cy) ky)
   (< kx rat_zero)
   (< ky rat_zero))
  ((union (Mk (@>= (Args x1 (Args x2 (Empty)))))
          (Mk (@>= (Args y1 (Args y2 (Empty)))))))
  :ruleset arith_poly)
