(ruleset arith_poly)
(constructor @* (Term) Term)
(constructor @- (Term) Term)
(constructor @/ (Term) Term)
(constructor @/_total (Term) Term)
(constructor @to_real (Term) Term)
(constructor @not (Term) Term)
(constructor @and (Term) Term)
(constructor @or (Term) Term)
(constructor @= (Term) Term)
(constructor @+ (Term) Term)

(let rat_zero (bigrat (bigint 0) (bigint 1)))
(let rat_one (bigrat (bigint 1) (bigint 1)))
(let rat_neg_one (bigrat (bigint -1) (bigint 1)))
(let int_sort (Sort (Const "Int")))
(let real_sort (Sort (Const "Real")))

(datatype G (PlusG G G G) (VarG BigRat Term) (CstG BigRat) (EmptyG))

(function addG (G G) G :no-merge)
(relation addG-demand (G G))

(function insertG (G G) G :merge old)
(relation insertG-demand (G G))

(function scaleG (BigRat G) G :no-merge)
(relation scaleG-demand (BigRat G))

(function polyOf (Term) G :no-merge)
(relation polyOf-demand (Term))

(function eqPolyOf (Term) G :no-merge)
(relation eqPolyOf-demand (Term))

(function isConstG (G) bool :no-merge)
(relation isConstG-demand (G))

(function hasVarG (G) bool :no-merge)
(relation hasVarG-demand (G))

(function arithTermSort (Term) Term :no-merge)
(relation arithTermSort-demand (Term))

(function eqOrientSignG (G) i64 :no-merge)
(relation eqOrientSignG-demand (G))

(function canonEqG (G) G :no-merge)
(relation canonEqG-demand (G))

;; ============================================================
;; isConstG / hasVarG
;; ============================================================

(rule
  ((isConstG-demand (EmptyG)))
  ((set (isConstG (EmptyG)) false))
  :ruleset arith_poly)

(rule
  ((isConstG-demand (CstG c)))
  ((set (isConstG (CstG c)) true))
  :ruleset arith_poly)

(rule
  ((isConstG-demand (VarG c x)))
  ((set (isConstG (VarG c x)) false))
  :ruleset arith_poly)

(rule
  ((isConstG-demand (PlusG a b rest)))
  ((set (isConstG (PlusG a b rest)) false))
  :ruleset arith_poly)

(rule
  ((hasVarG-demand (EmptyG)))
  ((set (hasVarG (EmptyG)) false))
  :ruleset arith_poly)

(rule
  ((hasVarG-demand (CstG c)))
  ((set (hasVarG (CstG c)) false))
  :ruleset arith_poly)

(rule
  ((hasVarG-demand (VarG c x)))
  ((set (hasVarG (VarG c x)) true))
  :ruleset arith_poly)

(rule
  ((hasVarG-demand (PlusG a b rest)))
  ((hasVarG-demand a)
   (hasVarG-demand b)
   (hasVarG-demand rest))
  :ruleset arith_poly)

(rule
  ((= (hasVarG a) ha)
   (= (hasVarG b) hb)
   (= (hasVarG rest) hr)
   (hasVarG-demand (PlusG a b rest)))
  ((set (hasVarG (PlusG a b rest)) (or ha (or hb hr))))
  :ruleset arith_poly)

;; ============================================================
;; arithTermSort
;; ============================================================

(rule
  ((arithTermSort-demand (Mk (Num i))))
  ((set (arithTermSort (Mk (Num i))) int_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (Real n d))))
  ((set (arithTermSort (Mk (Real n d))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (Var x s))))
  ((set (arithTermSort (Mk (Var x s))) s))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@to_real (Args t (Empty))))))
  ((set (arithTermSort (Mk (@to_real (Args t (Empty))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@+ (Args t (Empty))))))
  ((arithTermSort-demand t))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@+ (Args t (Empty)))))
   (= (arithTermSort t) s))
  ((set (arithTermSort (Mk (@+ (Args t (Empty))))) s))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@- (Args t (Empty))))))
  ((arithTermSort-demand t))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@- (Args t (Empty)))))
   (= (arithTermSort t) s))
  ((set (arithTermSort (Mk (@- (Args t (Empty))))) s))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty)))
  ((arithTermSort-demand t)
   (arithTermSort-demand t'))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t) int_sort)
   (= (arithTermSort t') int_sort))
  ((set (arithTermSort (Mk (@+ (Args t (Args t' (Empty)))))) int_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t) real_sort))
  ((set (arithTermSort (Mk (@+ (Args t (Args t' (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t') real_sort))
  ((set (arithTermSort (Mk (@+ (Args t (Args t' (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty)))
  ((arithTermSort-demand t)
   (arithTermSort-demand t'))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t) int_sort)
   (= (arithTermSort t') int_sort))
  ((set (arithTermSort (Mk (@- (Args t (Args t' (Empty)))))) int_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t) real_sort))
  ((set (arithTermSort (Mk (@- (Args t (Args t' (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t') real_sort))
  ((set (arithTermSort (Mk (@- (Args t (Args t' (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty)))
  ((arithTermSort-demand t)
   (arithTermSort-demand t'))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t) int_sort)
   (= (arithTermSort t') int_sort))
  ((set (arithTermSort (Mk (@* (Args t (Args t' (Empty)))))) int_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t) real_sort))
  ((set (arithTermSort (Mk (@* (Args t (Args t' (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (arithTermSort t') real_sort))
  ((set (arithTermSort (Mk (@* (Args t (Args t' (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (arithTermSort (Mk (@/ (Args t (Args d (Empty)))))) real_sort))
  :ruleset arith_poly)

(rule
  ((arithTermSort-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (arithTermSort (Mk (@/_total (Args t (Args d (Empty)))))) real_sort))
  :ruleset arith_poly)

;; ============================================================
;; addG
;; ============================================================

(rule
  ((addG-demand (CstG rat_zero) q))
  ((set (addG (CstG rat_zero) q) q))
  :ruleset arith_poly)

(rule
  ((addG-demand p (CstG rat_zero)))
  ((set (addG p (CstG rat_zero)) p))
  :ruleset arith_poly)

(rule
  ((addG-demand (CstG k) q))
  ((insertG-demand (CstG k) q))
  :ruleset arith_poly)

(rule
  ((= (insertG (CstG k) q) s)
   (addG-demand (CstG k) q))
  ((set (addG (CstG k) q) s))
  :ruleset arith_poly)

(rule
  ((addG-demand (VarG c x) q))
  ((insertG-demand (VarG c x) q))
  :ruleset arith_poly)

(rule
  ((= (insertG (VarG c x) q) s)
   (addG-demand (VarG c x) q))
  ((set (addG (VarG c x) q) s))
  :ruleset arith_poly)

(rule
  ((addG-demand (PlusG h t (EmptyG)) q))
  ((addG-demand t q))
  :ruleset arith_poly)

(rule
  ((= (addG t q) tq)
   (addG-demand (PlusG h t (EmptyG)) q))
  ((insertG-demand h tq))
  :ruleset arith_poly)

(rule
  ((= (addG t q) tq)
   (= (insertG h tq) s)
   (addG-demand (PlusG h t (EmptyG)) q))
  ((set (addG (PlusG h t (EmptyG)) q) s))
  :ruleset arith_poly)

;; ============================================================
;; insertG
;; ============================================================

(rule
  ((insertG-demand (CstG rat_zero) q))
  ((set (insertG (CstG rat_zero) q) q))
  :ruleset arith_poly)

(rule
  ((insertG-demand (CstG c) (CstG k)))
  ((set (insertG (CstG c) (CstG k))
        (CstG (+ c k))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (CstG c) (VarG d x)))
  ((set (insertG (CstG c) (VarG d x))
        (PlusG (CstG c) (VarG d x) (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (CstG c) (PlusG (CstG k) t (EmptyG)))
   (= (+ c k) rat_zero))
  ((set (insertG (CstG c) (PlusG (CstG k) t (EmptyG)))
        t))
  :ruleset arith_poly)

(rule
  ((insertG-demand (CstG c) (PlusG (CstG k) t (EmptyG)))
   (!= (+ c k) rat_zero))
  ((set (insertG (CstG c) (PlusG (CstG k) t (EmptyG)))
        (PlusG (CstG (+ c k)) t (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (CstG c) (PlusG (VarG d x) t (EmptyG))))
  ((set (insertG (CstG c) (PlusG (VarG d x) t (EmptyG)))
        (PlusG (CstG c)
               (PlusG (VarG d x) t (EmptyG))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c x) (CstG rat_zero)))
  ((set (insertG (VarG c x) (CstG rat_zero))
        (VarG c x)))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c x) (CstG k))
   (!= k rat_zero))
  ((set (insertG (VarG c x) (CstG k))
        (PlusG (CstG k) (VarG c x) (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
   (= x y)
   (= sx sy)
   (= (+ c1 c2) rat_zero))
  ((set (insertG (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
        (CstG rat_zero)))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
   (= x y)
   (= sx sy)
   (!= (+ c1 c2) rat_zero))
  ((set (insertG (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
        (VarG (+ c1 c2) (Var x sx))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
   (< x y))
  ((set (insertG (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
        (PlusG (VarG c1 (Var x sx))
               (VarG c2 (Var y sy))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
   (> x y))
  ((set (insertG (VarG c1 (Var x sx)) (VarG c2 (Var y sy)))
        (PlusG (VarG c2 (Var y sy))
               (VarG c1 (Var x sx))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x int_sort)) (VarG c2 (Var y real_sort)))
   (= x y))
  ((set (insertG (VarG c1 (Var x int_sort)) (VarG c2 (Var y real_sort)))
        (PlusG (VarG c1 (Var x int_sort))
               (VarG c2 (Var y real_sort))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x real_sort)) (VarG c2 (Var y int_sort)))
   (= x y))
  ((set (insertG (VarG c1 (Var x real_sort)) (VarG c2 (Var y int_sort)))
        (PlusG (VarG c2 (Var y int_sort))
               (VarG c1 (Var x real_sort))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c x) (PlusG (CstG k) t (EmptyG))))
  ((insertG-demand (VarG c x) t))
  :ruleset arith_poly)

(rule
  ((= (insertG (VarG c x) t) s)
   (insertG-demand (VarG c x) (PlusG (CstG k) t (EmptyG))))
  ((set (insertG (VarG c x) (PlusG (CstG k) t (EmptyG)))
        (PlusG (CstG k) s (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
   (= x y)
   (= sx sy)
   (= (+ c1 c2) rat_zero))
  ((set (insertG (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
        t))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
   (= x y)
   (= sx sy)
   (!= (+ c1 c2) rat_zero))
  ((set (insertG (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
        (PlusG (VarG (+ c1 c2) (Var x sx)) t (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
   (< x y))
  ((set (insertG (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
        (PlusG (VarG c1 (Var x sx))
               (PlusG (VarG c2 (Var y sy)) t (EmptyG))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
   (> x y))
  ((insertG-demand (VarG c1 (Var x sx)) t))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
   (> x y)
   (= (insertG (VarG c1 (Var x sx)) t) s))
  ((set (insertG (VarG c1 (Var x sx)) (PlusG (VarG c2 (Var y sy)) t (EmptyG)))
        (PlusG (VarG c2 (Var y sy)) s (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x int_sort))
                   (PlusG (VarG c2 (Var y real_sort)) t (EmptyG)))
   (= x y))
  ((set (insertG (VarG c1 (Var x int_sort))
                 (PlusG (VarG c2 (Var y real_sort)) t (EmptyG)))
        (PlusG (VarG c1 (Var x int_sort))
               (PlusG (VarG c2 (Var y real_sort)) t (EmptyG))
               (EmptyG))))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x real_sort))
                   (PlusG (VarG c2 (Var y int_sort)) t (EmptyG)))
   (= x y))
  ((insertG-demand (VarG c1 (Var x real_sort)) t))
  :ruleset arith_poly)

(rule
  ((insertG-demand (VarG c1 (Var x real_sort))
                   (PlusG (VarG c2 (Var y int_sort)) t (EmptyG)))
   (= x y)
   (= (insertG (VarG c1 (Var x real_sort)) t) s))
  ((set (insertG (VarG c1 (Var x real_sort))
                 (PlusG (VarG c2 (Var y int_sort)) t (EmptyG)))
        (PlusG (VarG c2 (Var y int_sort)) s (EmptyG))))
  :ruleset arith_poly)

;; ============================================================
;; scaleG
;; ============================================================

(rule
  ((scaleG-demand rat_zero p))
  ((set (scaleG rat_zero p) (CstG rat_zero)))
  :ruleset arith_poly)

(rule
  ((scaleG-demand rat_one p))
  ((set (scaleG rat_one p) p))
  :ruleset arith_poly)

(rule
  ((scaleG-demand k (CstG c)))
  ((set (scaleG k (CstG c))
        (CstG (* k c))))
  :ruleset arith_poly)

(rule
  ((scaleG-demand k (VarG c x))
   (= (* k c) rat_zero))
  ((set (scaleG k (VarG c x))
        (CstG rat_zero)))
  :ruleset arith_poly)

(rule
  ((scaleG-demand k (VarG c x))
   (!= (* k c) rat_zero))
  ((set (scaleG k (VarG c x))
        (VarG (* k c) x)))
  :ruleset arith_poly)

(rule
  ((scaleG-demand k (PlusG h t (EmptyG))))
  ((scaleG-demand k h)
   (scaleG-demand k t))
  :ruleset arith_poly)

(rule
  ((= (scaleG k h) sh)
   (= (scaleG k t) st)
   (scaleG-demand k (PlusG h t (EmptyG))))
  ((addG-demand sh st))
  :ruleset arith_poly)

(rule
  ((= (scaleG k h) sh)
   (= (scaleG k t) st)
   (= (addG sh st) s)
   (scaleG-demand k (PlusG h t (EmptyG))))
  ((set (scaleG k (PlusG h t (EmptyG))) s))
  :ruleset arith_poly)

;; ============================================================
;; polyOf
;; ============================================================

(rule
  ((polyOf-demand (Mk (Num i))))
  ((set (polyOf (Mk (Num i)))
        (CstG (bigrat (bigint i) (bigint 1)))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (Real n d))))
  ((set (polyOf (Mk (Real n d)))
        (CstG (bigrat (bigint n) (bigint d)))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (Var t s))))
  ((set (polyOf (Mk (Var t s)))
        (VarG rat_one (Var t s))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Empty)))
  ((set (polyOf (Empty))
        (CstG rat_zero)))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@+ (Args t (Empty))))))
  ((polyOf-demand t))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@+ (Args t (Empty)))))
   (= (polyOf t) p))
  ((set (polyOf (Mk (@+ (Args t (Empty))))) p))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Empty))))))
  ((polyOf-demand t))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Empty)))))
   (= (polyOf t) p))
  ((scaleG-demand rat_neg_one p))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Empty)))))
   (= (polyOf t) p)
   (= (scaleG rat_neg_one p) s))
  ((set (polyOf (Mk (@- (Args t (Empty))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty)))
  ((polyOf-demand t)
   (polyOf-demand t'))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2))
  ((addG-demand p1 p2))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@+ (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2)
   (= (addG p1 p2) s))
  ((set (polyOf (Mk (@+ (Args t (Args t' (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty)))
  ((polyOf-demand t)
   (polyOf-demand t'))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2))
  ((scaleG-demand rat_neg_one p2))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2)
   (= (scaleG rat_neg_one p2) neg_p2))
  ((addG-demand p1 neg_p2))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@- (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2)
   (= (scaleG rat_neg_one p2) neg_p2)
   (= (addG p1 neg_p2) s))
  ((set (polyOf (Mk (@- (Args t (Args t' (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty)))
  ((polyOf-demand t)
   (polyOf-demand t'))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2))
  ((isConstG-demand p1)
   (isConstG-demand p2))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) (CstG k))
   (= (polyOf t') p))
  ((scaleG-demand k p))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p)
   (= (polyOf t') (CstG k)))
  ((scaleG-demand k p))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) (CstG k))
   (= (polyOf t') p)
   (= (scaleG k p) s))
  ((set (polyOf (Mk (@* (Args t (Args t' (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p)
   (= (polyOf t') (CstG k))
   (= (scaleG k p) s))
  ((set (polyOf (Mk (@* (Args t (Args t' (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2)
   (= (isConstG p1) false)
   (= (isConstG p2) false))
  ((arithTermSort-demand (Mk (@* (Args t (Args t' (Empty)))))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@* (Args t (Args t' (Empty))))))
   (!= t' (Empty))
   (= (polyOf t) p1)
   (= (polyOf t') p2)
   (= (isConstG p1) false)
   (= (isConstG p2) false)
   (= (arithTermSort (Mk (@* (Args t (Args t' (Empty)))))) s))
  ((set (polyOf (Mk (@* (Args t (Args t' (Empty))))))
        (VarG rat_one
              (Var (arith_poly_atom_hash
                     (Mk (@* (Args t (Args t' (Empty)))))) s))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@to_real (Args t (Empty))))))
  ((polyOf-demand t))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@to_real (Args t (Empty)))))
   (= (polyOf t) p))
  ((set (polyOf (Mk (@to_real (Args t (Empty))))) p))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((polyOf-demand t)
   (polyOf-demand d))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf d) pd))
  ((isConstG-demand pd))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf t) pt)
   (= (polyOf d) (CstG k))
   (!= k rat_zero))
  ((scaleG-demand (/ rat_one k) pt))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf t) pt)
   (= (polyOf d) (CstG k))
   (!= k rat_zero)
   (= (scaleG (/ rat_one k) pt) s))
  ((set (polyOf (Mk (@/ (Args t (Args d (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf d) (CstG rat_zero)))
  ((set (polyOf (Mk (@/ (Args t (Args d (Empty))))))
        (VarG rat_one
              (Var (arith_poly_atom_hash
                     (Mk (@/ (Args t (Args d (Empty)))))) real_sort))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf d) pd)
   (= (isConstG pd) false))
  ((set (polyOf (Mk (@/ (Args t (Args d (Empty))))))
        (VarG rat_one
              (Var (arith_poly_atom_hash
                     (Mk (@/ (Args t (Args d (Empty)))))) real_sort))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((polyOf-demand t)
   (polyOf-demand d))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf d) pd))
  ((isConstG-demand pd))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf t) pt)
   (= (polyOf d) (CstG k))
   (!= k rat_zero))
  ((scaleG-demand (/ rat_one k) pt))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf t) pt)
   (= (polyOf d) (CstG k))
   (!= k rat_zero)
   (= (scaleG (/ rat_one k) pt) s))
  ((set (polyOf (Mk (@/_total (Args t (Args d (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf d) (CstG rat_zero)))
  ((set (polyOf (Mk (@/_total (Args t (Args d (Empty))))))
        (VarG rat_one
              (Var (arith_poly_atom_hash
                     (Mk (@/_total (Args t (Args d (Empty)))))) real_sort))))
  :ruleset arith_poly)

(rule
  ((polyOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty))
   (= (polyOf d) pd)
   (= (isConstG pd) false))
  ((set (polyOf (Mk (@/_total (Args t (Args d (Empty))))))
        (VarG rat_one
              (Var (arith_poly_atom_hash
                     (Mk (@/_total (Args t (Args d (Empty)))))) real_sort))))
  :ruleset arith_poly)

;; ============================================================
;; eqPolyOf
;; ============================================================

(rule
  ((eqPolyOf-demand (Mk (@= (Args t1 (Args t2 (Empty))))))
   (!= t2 (Empty)))
  ((polyOf-demand t1)
   (polyOf-demand t2))
  :ruleset arith_poly)

(rule
  ((eqPolyOf-demand (Mk (@= (Args t1 (Args t2 (Empty))))))
   (!= t2 (Empty))
   (= (polyOf t1) p1)
   (= (polyOf t2) p2))
  ((scaleG-demand rat_neg_one p2))
  :ruleset arith_poly)

(rule
  ((eqPolyOf-demand (Mk (@= (Args t1 (Args t2 (Empty))))))
   (!= t2 (Empty))
   (= (polyOf t1) p1)
   (= (polyOf t2) p2)
   (= (scaleG rat_neg_one p2) neg_p2))
  ((addG-demand p1 neg_p2))
  :ruleset arith_poly)

(rule
  ((eqPolyOf-demand (Mk (@= (Args t1 (Args t2 (Empty))))))
   (!= t2 (Empty))
   (= (polyOf t1) p1)
   (= (polyOf t2) p2)
   (= (scaleG rat_neg_one p2) neg_p2)
   (= (addG p1 neg_p2) diff))
  ((canonEqG-demand diff))
  :ruleset arith_poly)

(rule
  ((eqPolyOf-demand (Mk (@= (Args t1 (Args t2 (Empty))))))
   (!= t2 (Empty))
   (= (polyOf t1) p1)
   (= (polyOf t2) p2)
   (= (scaleG rat_neg_one p2) neg_p2)
   (= (addG p1 neg_p2) diff)
   (= (canonEqG diff) canon_diff))
  ((set (eqPolyOf (Mk (@= (Args t1 (Args t2 (Empty)))))) canon_diff))
  :ruleset arith_poly)

;; ============================================================
;; eqOrientSignG / canonEqG
;; ============================================================

(rule
  ((eqOrientSignG-demand (CstG k))
   (< k rat_zero))
  ((set (eqOrientSignG (CstG k)) -1))
  :ruleset arith_poly)

(rule
  ((eqOrientSignG-demand (CstG k))
   (>= k rat_zero))
  ((set (eqOrientSignG (CstG k)) 1))
  :ruleset arith_poly)

(rule
  ((eqOrientSignG-demand (VarG c x))
   (< c rat_zero))
  ((set (eqOrientSignG (VarG c x)) -1))
  :ruleset arith_poly)

(rule
  ((eqOrientSignG-demand (VarG c x))
   (>= c rat_zero))
  ((set (eqOrientSignG (VarG c x)) 1))
  :ruleset arith_poly)

(rule
  ((eqOrientSignG-demand (PlusG a b rest)))
  ((hasVarG-demand a)
   (hasVarG-demand b)
   (hasVarG-demand rest)
   (eqOrientSignG-demand a)
   (eqOrientSignG-demand b)
   (eqOrientSignG-demand rest))
  :ruleset arith_poly)

(rule
  ((= (hasVarG a) true)
   (= (eqOrientSignG a) sa)
   (eqOrientSignG-demand (PlusG a b rest)))
  ((set (eqOrientSignG (PlusG a b rest)) sa))
  :ruleset arith_poly)

(rule
  ((= (hasVarG a) false)
   (= (hasVarG b) true)
   (= (eqOrientSignG b) sb)
   (eqOrientSignG-demand (PlusG a b rest)))
  ((set (eqOrientSignG (PlusG a b rest)) sb))
  :ruleset arith_poly)

(rule
  ((= (hasVarG a) false)
   (= (hasVarG b) false)
   (= (hasVarG rest) true)
   (= (eqOrientSignG rest) sr)
   (eqOrientSignG-demand (PlusG a b rest)))
  ((set (eqOrientSignG (PlusG a b rest)) sr))
  :ruleset arith_poly)

(rule
  ((= (hasVarG a) false)
   (= (hasVarG b) false)
   (= (hasVarG rest) false)
   (= (eqOrientSignG a) sa)
   (eqOrientSignG-demand (PlusG a b rest)))
  ((set (eqOrientSignG (PlusG a b rest)) sa))
  :ruleset arith_poly)

(rule
  ((canonEqG-demand g))
  ((eqOrientSignG-demand g))
  :ruleset arith_poly)

(rule
  ((= (eqOrientSignG g) s)
   (< s 0)
   (canonEqG-demand g))
  ((scaleG-demand rat_neg_one g))
  :ruleset arith_poly)

(rule
  ((= (eqOrientSignG g) s)
   (< s 0)
   (= (scaleG rat_neg_one g) neg_g)
   (canonEqG-demand g))
  ((set (canonEqG g) neg_g))
  :ruleset arith_poly)

(rule
  ((= (eqOrientSignG g) s)
   (>= s 0)
   (canonEqG-demand g))
  ((set (canonEqG g) g))
  :ruleset arith_poly)
