(ruleset arith_poly)
(ruleset arith_poly_guard)
(constructor @* (Term) Term)
(constructor @- (Term) Term)
(constructor @/ (Term) Term)
(constructor @/_total (Term) Term)
(constructor @to_real (Term) Term)
(constructor @not (Term) Term)
(constructor @and (Term) Term)
(constructor @or (Term) Term)
(constructor @= (Term) Term)
(constructor @+ (Term) Term)
(constructor @arith_pos1 (Term) Term)
(constructor @arith_add2 (Term) Term)
(constructor @arith_neg1 (Term) Term)
(constructor @arith_sub2 (Term) Term)
(constructor RatConst (BigRat) Term)

(let rat_zero (bigrat (bigint 0) (bigint 1)))
(let rat_one (bigrat (bigint 1) (bigint 1)))
(let rat_neg_one (bigrat (bigint -1) (bigint 1)))
(let int_sort (Sort (Const "Int")))
(let real_sort (Sort (Const "Real")))

;; ============================================================
;; arith_poly_norm
;;
;; EO-aligned replacement for the current affine equality path.
;;
;; What this matches from EO:
;;   - full polynomial normalization for arithmetic terms
;;   - commutative monomial multiplication
;;   - distribution over +
;;   - to_real erasure
;;   - zero-coefficient cancellation
;;   - / and /_total scale only when the denominator normalizes to a
;;     nonzero constant; otherwise the whole division term is opaque
;;
;; Performance:
;;   - fully demand-driven
;;   - only equality atoms trigger normalization
;;   - nonlinear blow-up is still possible (same as EO semantics), so keep
;;     any affine fast-path in a separate, non-EO ruleset
;;
;; Assumes already in scope:
;;   - rat_zero / rat_one / rat_neg_one
;;   - @+, @-, @*, @/, @/_total, @to_real, @=
;;   - RatConst
;;   - arith_poly_atom_hash : Term -> i64
;;   - source + / - terms are lowered to arity-safe helper terms before
;;     normalization
;;   - n-ary * / /_total terms are left-associated on demand
;; ============================================================

(datatype MonN
  (MOne)
  (MCons i64 MonN))

(datatype PolyN
  (PZero)
  (PCons MonN BigRat PolyN))

(constructor ArithEqKey (PolyN) Term)

(function atomMonN (Term) MonN :no-merge)
(relation atomMonN-demand (Term))

(function atomPolyN (Term) PolyN :no-merge)
(relation atomPolyN-demand (Term))

(function cmpMonN (MonN MonN) i64 :no-merge)
(relation cmpMonN-demand (MonN MonN))

(function mulMonN (MonN MonN) MonN :no-merge)
(relation mulMonN-demand (MonN MonN))

(function scalePolyN (BigRat PolyN) PolyN :no-merge)
(relation scalePolyN-demand (BigRat PolyN))

(function addPolyN (PolyN PolyN) PolyN :no-merge)
(relation addPolyN-demand (PolyN PolyN))

(function mulMonIntoPolyN (MonN BigRat PolyN) PolyN :no-merge)
(relation mulMonIntoPolyN-demand (MonN BigRat PolyN))

(function mulPolyN (PolyN PolyN) PolyN :no-merge)
(relation mulPolyN-demand (PolyN PolyN))

(function polyIsConstN (PolyN) bool :no-merge)
(relation polyIsConstN-demand (PolyN))

(function polyConstN (PolyN) BigRat :no-merge)
(relation polyConstN-demand (PolyN))

(function arithPolyNfOf (Term) PolyN :no-merge)
(relation arithPolyNfOf-demand (Term))
(function arithSyntaxOf (Term) Term :merge old)

(function arithGoalPolyCanMatch (Term) bool :merge old)
(function arithGoalPolyNfOf (Term) PolyN :no-merge)
(relation arithGoalPolyNfOf-demand (Term))

;; ------------------------------------------------------------
;; arity-safe source lowering
;; ------------------------------------------------------------

(rule
  ((= (arithSyntaxOf t) shaped)
   (arithPolyNfOf-demand t))
  ((arithPolyNfOf-demand shaped))
  :ruleset arith_poly)

(rule
  ((= (arithSyntaxOf t) shaped)
   (= (arithPolyNfOf shaped) p)
   (arithPolyNfOf-demand t))
  ((set (arithPolyNfOf t) p))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; goal-facing numeric normalization wrapper
;; ------------------------------------------------------------

(rule
  ((arithGoalPolyNfOf-demand (Mk (Num i))))
  ((set (arithGoalPolyCanMatch (Mk (Num i))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Num i))))
  ((arithPolyNfOf-demand (Mk (Num i))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Real n d))))
  ((set (arithGoalPolyCanMatch (Mk (Real n d))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Real n d))))
  ((arithPolyNfOf-demand (Mk (Real n d))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (RatConst q))))
  ((set (arithGoalPolyCanMatch (Mk (RatConst q))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (RatConst q))))
  ((arithPolyNfOf-demand (Mk (RatConst q))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Var x int_sort))))
  ((set (arithGoalPolyCanMatch (Mk (Var x int_sort))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Var x int_sort))))
  ((arithPolyNfOf-demand (Mk (Var x int_sort))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Var x real_sort))))
  ((set (arithGoalPolyCanMatch (Mk (Var x real_sort))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (Var x real_sort))))
  ((arithPolyNfOf-demand (Mk (Var x real_sort))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@+ args))))
  ((set (arithGoalPolyCanMatch (Mk (@+ args))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@+ args))))
  ((arithPolyNfOf-demand (Mk (@+ args))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@- args))))
  ((set (arithGoalPolyCanMatch (Mk (@- args))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@- args))))
  ((arithPolyNfOf-demand (Mk (@- args))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@* args))))
  ((set (arithGoalPolyCanMatch (Mk (@* args))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@* args))))
  ((arithPolyNfOf-demand (Mk (@* args))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@/ args))))
  ((set (arithGoalPolyCanMatch (Mk (@/ args))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@/ args))))
  ((arithPolyNfOf-demand (Mk (@/ args))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@/_total args))))
  ((set (arithGoalPolyCanMatch (Mk (@/_total args))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@/_total args))))
  ((arithPolyNfOf-demand (Mk (@/_total args))))
  :ruleset arith_poly)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@to_real args))))
  ((set (arithGoalPolyCanMatch (Mk (@to_real args))) true))
  :ruleset arith_poly_guard)

(rule
  ((arithGoalPolyNfOf-demand (Mk (@to_real args))))
  ((arithPolyNfOf-demand (Mk (@to_real args))))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p)
   (arithGoalPolyNfOf-demand t))
  ((set (arithGoalPolyNfOf t) p))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; n-ary left-assoc des-binarization
;; ------------------------------------------------------------

(datatype DesbinN
  (Desbin Term Term))

(relation mulDesbinN-demand (Term DesbinN))
(relation divDesbinN-demand (Term DesbinN))
(relation divTotalDesbinN-demand (Term DesbinN))

;; *  : left-associate n-ary applications on demand
(rule
  ((mulDesbinN-demand torig (Desbin acc (Args z rest)))
   (!= rest (Empty)))
  ((mulDesbinN-demand
    torig
    (Desbin (Mk (@* (Args acc (Args z (Empty))))) rest)))
  :ruleset arith_poly)

(rule
  ((mulDesbinN-demand torig (Desbin acc (Args z (Empty)))))
  ((union torig (Mk (@* (Args acc (Args z (Empty))))))
   (arithPolyNfOf-demand (Mk (@* (Args acc (Args z (Empty)))))))
  :ruleset arith_poly)

;; /  : left-associate n-ary applications on demand
(rule
  ((divDesbinN-demand torig (Desbin acc (Args z rest)))
   (!= rest (Empty)))
  ((divDesbinN-demand
    torig
    (Desbin (Mk (@/ (Args acc (Args z (Empty))))) rest)))
  :ruleset arith_poly)

(rule
  ((divDesbinN-demand torig (Desbin acc (Args z (Empty)))))
  ((union torig (Mk (@/ (Args acc (Args z (Empty))))))
   (arithPolyNfOf-demand (Mk (@/ (Args acc (Args z (Empty)))))))
  :ruleset arith_poly)

;; /_total  : left-associate n-ary applications on demand
(rule
  ((divTotalDesbinN-demand torig (Desbin acc (Args z rest)))
   (!= rest (Empty)))
  ((divTotalDesbinN-demand
    torig
    (Desbin (Mk (@/_total (Args acc (Args z (Empty))))) rest)))
  :ruleset arith_poly)

(rule
  ((divTotalDesbinN-demand torig (Desbin acc (Args z (Empty)))))
  ((union torig (Mk (@/_total (Args acc (Args z (Empty))))))
   (arithPolyNfOf-demand (Mk (@/_total (Args acc (Args z (Empty)))))))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; opaque atoms
;; ------------------------------------------------------------

(rule
  ((atomMonN-demand t))
  ((set (atomMonN t)
        (MCons (arith_poly_atom_hash t) (MOne))))
  :ruleset arith_poly)

(rule
  ((atomPolyN-demand t))
  ((atomMonN-demand t))
  :ruleset arith_poly)

(rule
  ((= (atomMonN t) m)
   (atomPolyN-demand t))
  ((set (atomPolyN t)
        (PCons m rat_one (PZero))))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; monomial comparison (lexicographic on sorted atom ids)
;; ------------------------------------------------------------

(rule
  ((cmpMonN-demand (MOne) (MOne)))
  ((set (cmpMonN (MOne) (MOne)) 0))
  :ruleset arith_poly)

(rule
  ((cmpMonN-demand (MOne) (MCons h t)))
  ((set (cmpMonN (MOne) (MCons h t)) -1))
  :ruleset arith_poly)

(rule
  ((cmpMonN-demand (MCons h t) (MOne)))
  ((set (cmpMonN (MCons h t) (MOne)) 1))
  :ruleset arith_poly)

(rule
  ((cmpMonN-demand (MCons h1 t1) (MCons h2 t2))
   (< h1 h2))
  ((set (cmpMonN (MCons h1 t1) (MCons h2 t2)) -1))
  :ruleset arith_poly)

(rule
  ((cmpMonN-demand (MCons h1 t1) (MCons h2 t2))
   (> h1 h2))
  ((set (cmpMonN (MCons h1 t1) (MCons h2 t2)) 1))
  :ruleset arith_poly)

(rule
  ((cmpMonN-demand (MCons h t1) (MCons h t2)))
  ((cmpMonN-demand t1 t2))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN t1 t2) c)
   (cmpMonN-demand (MCons h t1) (MCons h t2)))
  ((set (cmpMonN (MCons h t1) (MCons h t2)) c))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; monomial multiplication (merge two sorted factor lists)
;; ------------------------------------------------------------

(rule
  ((mulMonN-demand (MOne) m))
  ((set (mulMonN (MOne) m) m))
  :ruleset arith_poly)

(rule
  ((mulMonN-demand m (MOne)))
  ((set (mulMonN m (MOne)) m))
  :ruleset arith_poly)

(rule
  ((mulMonN-demand (MCons h1 t1) (MCons h2 t2))
   (< h1 h2))
  ((mulMonN-demand t1 (MCons h2 t2)))
  :ruleset arith_poly)

(rule
  ((= (mulMonN t1 (MCons h2 t2)) r)
   (mulMonN-demand (MCons h1 t1) (MCons h2 t2))
   (< h1 h2))
  ((set (mulMonN (MCons h1 t1) (MCons h2 t2))
        (MCons h1 r)))
  :ruleset arith_poly)

(rule
  ((mulMonN-demand (MCons h t1) (MCons h t2)))
  ((mulMonN-demand t1 (MCons h t2)))
  :ruleset arith_poly)

(rule
  ((= (mulMonN t1 (MCons h t2)) r)
   (mulMonN-demand (MCons h t1) (MCons h t2)))
  ((set (mulMonN (MCons h t1) (MCons h t2))
        (MCons h r)))
  :ruleset arith_poly)

(rule
  ((mulMonN-demand (MCons h1 t1) (MCons h2 t2))
   (> h1 h2))
  ((mulMonN-demand (MCons h1 t1) t2))
  :ruleset arith_poly)

(rule
  ((= (mulMonN (MCons h1 t1) t2) r)
   (mulMonN-demand (MCons h1 t1) (MCons h2 t2))
   (> h1 h2))
  ((set (mulMonN (MCons h1 t1) (MCons h2 t2))
        (MCons h2 r)))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; scale polynomial
;; ------------------------------------------------------------

(rule
  ((scalePolyN-demand rat_zero p))
  ((set (scalePolyN rat_zero p) (PZero)))
  :ruleset arith_poly)

(rule
  ((scalePolyN-demand k (PZero)))
  ((set (scalePolyN k (PZero)) (PZero)))
  :ruleset arith_poly)

(rule
  ((scalePolyN-demand rat_one p))
  ((set (scalePolyN rat_one p) p))
  :ruleset arith_poly)

(rule
  ((scalePolyN-demand k (PCons m c rest))
   (= (* k c) rat_zero))
  ((scalePolyN-demand k rest))
  :ruleset arith_poly)

(rule
  ((= (scalePolyN k rest) s)
   (scalePolyN-demand k (PCons m c rest))
   (= (* k c) rat_zero))
  ((set (scalePolyN k (PCons m c rest)) s))
  :ruleset arith_poly)

(rule
  ((scalePolyN-demand k (PCons m c rest))
   (!= (* k c) rat_zero))
  ((scalePolyN-demand k rest))
  :ruleset arith_poly)

(rule
  ((= (scalePolyN k rest) s)
   (scalePolyN-demand k (PCons m c rest))
   (!= (* k c) rat_zero))
  ((set (scalePolyN k (PCons m c rest))
        (PCons m (* k c) s)))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; add polynomial
;; ------------------------------------------------------------

(rule
  ((addPolyN-demand (PZero) q))
  ((set (addPolyN (PZero) q) q))
  :ruleset arith_poly)

(rule
  ((addPolyN-demand p (PZero)))
  ((set (addPolyN p (PZero)) p))
  :ruleset arith_poly)

(rule
  ((addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((cmpMonN-demand m1 m2))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) 0)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((addPolyN-demand p1 p2))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) 0)
   (= (+ c1 c2) rat_zero)
   (= (addPolyN p1 p2) s)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((set (addPolyN (PCons m1 c1 p1) (PCons m2 c2 p2)) s))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) 0)
   (!= (+ c1 c2) rat_zero)
   (= (addPolyN p1 p2) s)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((set (addPolyN (PCons m1 c1 p1) (PCons m2 c2 p2))
        (PCons m1 (+ c1 c2) s)))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) -1)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((addPolyN-demand p1 (PCons m2 c2 p2)))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) -1)
   (= (addPolyN p1 (PCons m2 c2 p2)) s)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((set (addPolyN (PCons m1 c1 p1) (PCons m2 c2 p2))
        (PCons m1 c1 s)))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) 1)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((addPolyN-demand (PCons m1 c1 p1) p2))
  :ruleset arith_poly)

(rule
  ((= (cmpMonN m1 m2) 1)
   (= (addPolyN (PCons m1 c1 p1) p2) s)
   (addPolyN-demand (PCons m1 c1 p1) (PCons m2 c2 p2)))
  ((set (addPolyN (PCons m1 c1 p1) (PCons m2 c2 p2))
        (PCons m2 c2 s)))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; multiply a monomial into a polynomial
;; ------------------------------------------------------------

(rule
  ((mulMonIntoPolyN-demand m rat_zero p))
  ((set (mulMonIntoPolyN m rat_zero p) (PZero)))
  :ruleset arith_poly)

(rule
  ((mulMonIntoPolyN-demand m c (PZero)))
  ((set (mulMonIntoPolyN m c (PZero)) (PZero)))
  :ruleset arith_poly)

(rule
  ((mulMonIntoPolyN-demand m1 c1 (PCons m2 c2 rest)))
  ((mulMonN-demand m1 m2)
   (mulMonIntoPolyN-demand m1 c1 rest))
  :ruleset arith_poly)

(rule
  ((= (mulMonN m1 m2) mm)
   (= (mulMonIntoPolyN m1 c1 rest) tail)
   (= (* c1 c2) rat_zero)
   (mulMonIntoPolyN-demand m1 c1 (PCons m2 c2 rest)))
  ((set (mulMonIntoPolyN m1 c1 (PCons m2 c2 rest)) tail))
  :ruleset arith_poly)

(rule
  ((= (mulMonN m1 m2) mm)
   (= (mulMonIntoPolyN m1 c1 rest) tail)
   (!= (* c1 c2) rat_zero)
   (mulMonIntoPolyN-demand m1 c1 (PCons m2 c2 rest)))
  ((addPolyN-demand (PCons mm (* c1 c2) (PZero)) tail))
  :ruleset arith_poly)

(rule
  ((= (mulMonN m1 m2) mm)
   (= (mulMonIntoPolyN m1 c1 rest) tail)
   (!= (* c1 c2) rat_zero)
   (= (addPolyN (PCons mm (* c1 c2) (PZero)) tail) s)
   (mulMonIntoPolyN-demand m1 c1 (PCons m2 c2 rest)))
  ((set (mulMonIntoPolyN m1 c1 (PCons m2 c2 rest)) s))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; multiply polynomials
;; ------------------------------------------------------------

(rule
  ((mulPolyN-demand (PZero) q))
  ((set (mulPolyN (PZero) q) (PZero)))
  :ruleset arith_poly)

(rule
  ((mulPolyN-demand p (PZero)))
  ((set (mulPolyN p (PZero)) (PZero)))
  :ruleset arith_poly)

(rule
  ((mulPolyN-demand (PCons m c rest) q))
  ((mulMonIntoPolyN-demand m c q)
   (mulPolyN-demand rest q))
  :ruleset arith_poly)

(rule
  ((= (mulMonIntoPolyN m c q) h)
   (= (mulPolyN rest q) t)
   (mulPolyN-demand (PCons m c rest) q))
  ((addPolyN-demand h t))
  :ruleset arith_poly)

(rule
  ((= (mulMonIntoPolyN m c q) h)
   (= (mulPolyN rest q) t)
   (= (addPolyN h t) s)
   (mulPolyN-demand (PCons m c rest) q))
  ((set (mulPolyN (PCons m c rest) q) s))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; constant polynomial predicates
;; ------------------------------------------------------------

(rule
  ((polyIsConstN-demand (PZero)))
  ((set (polyIsConstN (PZero)) true))
  :ruleset arith_poly)

(rule
  ((polyConstN-demand (PZero)))
  ((set (polyConstN (PZero)) rat_zero))
  :ruleset arith_poly)

(rule
  ((polyIsConstN-demand (PCons (MOne) c (PZero))))
  ((set (polyIsConstN (PCons (MOne) c (PZero))) true))
  :ruleset arith_poly)

(rule
  ((polyConstN-demand (PCons (MOne) c (PZero))))
  ((set (polyConstN (PCons (MOne) c (PZero))) c))
  :ruleset arith_poly)

(rule
  ((polyIsConstN-demand (PCons (MOne) c rest))
   (!= rest (PZero)))
  ((set (polyIsConstN (PCons (MOne) c rest)) false))
  :ruleset arith_poly)

(rule
  ((polyIsConstN-demand (PCons (MCons h t) c rest)))
  ((set (polyIsConstN (PCons (MCons h t) c rest)) false))
  :ruleset arith_poly)

;; ------------------------------------------------------------
;; arithmetic term -> polynomial NF
;; ------------------------------------------------------------

;; literal constants
(rule
  ((arithPolyNfOf-demand (Mk (Num 0))))
  ((set (arithPolyNfOf (Mk (Num 0))) (PZero)))
  :ruleset arith_poly)

(rule
  ((arithPolyNfOf-demand (Mk (Num i)))
   (!= i 0))
  ((set (arithPolyNfOf (Mk (Num i)))
        (PCons (MOne)
               (bigrat (bigint i) (bigint 1))
               (PZero))))
  :ruleset arith_poly)

(rule
  ((arithPolyNfOf-demand (Mk (Real 0 d))))
  ((set (arithPolyNfOf (Mk (Real 0 d))) (PZero)))
  :ruleset arith_poly)

(rule
  ((arithPolyNfOf-demand (Mk (Real n d)))
   (!= n 0))
  ((set (arithPolyNfOf (Mk (Real n d)))
        (PCons (MOne)
               (bigrat (bigint n) (bigint d))
               (PZero))))
  :ruleset arith_poly)

(rule
  ((arithPolyNfOf-demand (Mk (RatConst rat_zero))))
  ((set (arithPolyNfOf (Mk (RatConst rat_zero))) (PZero)))
  :ruleset arith_poly)

(rule
  ((arithPolyNfOf-demand (Mk (RatConst q)))
   (!= q rat_zero))
  ((set (arithPolyNfOf (Mk (RatConst q)))
        (PCons (MOne) q (PZero))))
  :ruleset arith_poly)

;; variables / opaque leaves
(rule
  ((arithPolyNfOf-demand (Mk (Var x s))))
  ((atomPolyN-demand (Mk (Var x s))))
  :ruleset arith_poly)

(rule
  ((= (atomPolyN (Mk (Var x s))) p)
   (arithPolyNfOf-demand (Mk (Var x s))))
  ((set (arithPolyNfOf (Mk (Var x s))) p))
  :ruleset arith_poly)

;; unary +
(rule
  ((arithPolyNfOf-demand (Mk (@arith_pos1 (Args t (Empty))))))
  ((arithPolyNfOf-demand t))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p)
   (arithPolyNfOf-demand (Mk (@arith_pos1 (Args t (Empty))))))
  ((set (arithPolyNfOf (Mk (@arith_pos1 (Args t (Empty))))) p))
  :ruleset arith_poly)

;; unary -
(rule
  ((arithPolyNfOf-demand (Mk (@arith_neg1 (Args t (Empty))))))
  ((arithPolyNfOf-demand t))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p)
   (arithPolyNfOf-demand (Mk (@arith_neg1 (Args t (Empty))))))
  ((scalePolyN-demand rat_neg_one p))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p)
   (= (scalePolyN rat_neg_one p) s)
   (arithPolyNfOf-demand (Mk (@arith_neg1 (Args t (Empty))))))
  ((set (arithPolyNfOf (Mk (@arith_neg1 (Args t (Empty))))) s))
  :ruleset arith_poly)

;; binary +
(rule
  ((arithPolyNfOf-demand (Mk (@arith_add2 (Args t (Args u (Empty)))))))
  ((arithPolyNfOf-demand t)
   (arithPolyNfOf-demand u))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p1)
   (= (arithPolyNfOf u) p2)
   (arithPolyNfOf-demand (Mk (@arith_add2 (Args t (Args u (Empty)))))))
  ((addPolyN-demand p1 p2))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p1)
   (= (arithPolyNfOf u) p2)
   (= (addPolyN p1 p2) s)
   (arithPolyNfOf-demand (Mk (@arith_add2 (Args t (Args u (Empty)))))))
  ((set (arithPolyNfOf (Mk (@arith_add2 (Args t (Args u (Empty)))))) s))
  :ruleset arith_poly)

;; binary -
(rule
  ((arithPolyNfOf-demand (Mk (@arith_sub2 (Args t (Args u (Empty)))))))
  ((arithPolyNfOf-demand t)
   (arithPolyNfOf-demand u))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf u) p2)
   (arithPolyNfOf-demand (Mk (@arith_sub2 (Args t (Args u (Empty)))))))
  ((scalePolyN-demand rat_neg_one p2))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p1)
   (= (arithPolyNfOf u) p2)
   (= (scalePolyN rat_neg_one p2) neg_p2)
   (arithPolyNfOf-demand (Mk (@arith_sub2 (Args t (Args u (Empty)))))))
  ((addPolyN-demand p1 neg_p2))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p1)
   (= (arithPolyNfOf u) p2)
   (= (scalePolyN rat_neg_one p2) neg_p2)
   (= (addPolyN p1 neg_p2) s)
   (arithPolyNfOf-demand (Mk (@arith_sub2 (Args t (Args u (Empty)))))))
  ((set (arithPolyNfOf (Mk (@arith_sub2 (Args t (Args u (Empty)))))) s))
  :ruleset arith_poly)

;; binary *
(rule
  ((arithPolyNfOf-demand (Mk (@* (Args x (Args y rest)))))
   (!= rest (Empty)))
  ((mulDesbinN-demand
    (Mk (@* (Args x (Args y rest))))
    (Desbin (Mk (@* (Args x (Args y (Empty))))) rest)))
  :ruleset arith_poly)

;; binary *
(rule
  ((arithPolyNfOf-demand (Mk (@* (Args t (Args u (Empty))))))
   (!= u (Empty)))
  ((arithPolyNfOf-demand t)
   (arithPolyNfOf-demand u))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p1)
   (= (arithPolyNfOf u) p2)
   (arithPolyNfOf-demand (Mk (@* (Args t (Args u (Empty))))))
   (!= u (Empty)))
  ((mulPolyN-demand p1 p2))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p1)
   (= (arithPolyNfOf u) p2)
   (= (mulPolyN p1 p2) s)
   (arithPolyNfOf-demand (Mk (@* (Args t (Args u (Empty))))))
   (!= u (Empty)))
  ((set (arithPolyNfOf (Mk (@* (Args t (Args u (Empty)))))) s))
  :ruleset arith_poly)

;; to_real
(rule
  ((arithPolyNfOf-demand (Mk (@to_real (Args t (Empty))))))
  ((arithPolyNfOf-demand t))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) p)
   (arithPolyNfOf-demand (Mk (@to_real (Args t (Empty))))))
  ((set (arithPolyNfOf (Mk (@to_real (Args t (Empty))))) p))
  :ruleset arith_poly)

;; /  -- if denominator is not a nonzero constant, keep the whole term opaque
(rule
  ((arithPolyNfOf-demand (Mk (@/ (Args x (Args y rest)))))
   (!= rest (Empty)))
  ((divDesbinN-demand
    (Mk (@/ (Args x (Args y rest))))
    (Desbin (Mk (@/ (Args x (Args y (Empty))))) rest)))
  :ruleset arith_poly)

;; /  -- if denominator is not a nonzero constant, keep the whole term opaque
(rule
  ((arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((arithPolyNfOf-demand t)
   (arithPolyNfOf-demand d))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf d) pd)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((polyIsConstN-demand pd))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) true)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((polyConstN-demand pd))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) pt)
   (= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) true)
   (= (polyConstN pd) k)
   (!= k rat_zero)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((scalePolyN-demand (/ rat_one k) pt))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) pt)
   (= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) true)
   (= (polyConstN pd) k)
   (!= k rat_zero)
   (= (scalePolyN (/ rat_one k) pt) s)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (arithPolyNfOf (Mk (@/ (Args t (Args d (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) false)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((atomPolyN-demand (Mk (@/ (Args t (Args d (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) true)
   (= (polyConstN pd) rat_zero)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((atomPolyN-demand (Mk (@/ (Args t (Args d (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (atomPolyN (Mk (@/ (Args t (Args d (Empty)))))) p)
   (= (arithPolyNfOf d) pd)
   (arithPolyNfOf-demand (Mk (@/ (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (arithPolyNfOf (Mk (@/ (Args t (Args d (Empty)))))) p))
  :ruleset arith_poly)

;; /_total -- same EO treatment as /
(rule
  ((arithPolyNfOf-demand (Mk (@/_total (Args x (Args y rest)))))
   (!= rest (Empty)))
  ((divTotalDesbinN-demand
    (Mk (@/_total (Args x (Args y rest))))
    (Desbin (Mk (@/_total (Args x (Args y (Empty))))) rest)))
  :ruleset arith_poly)

