   (= (polyIsConstN pd) true)
   (= (polyConstN pd) k)
   (!= k rat_zero)
   (arithPolyNfOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((scalePolyN-demand (/ rat_one k) pt))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf t) pt)
   (= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) true)
   (= (polyConstN pd) k)
   (!= k rat_zero)
   (= (scalePolyN (/ rat_one k) pt) s)
   (arithPolyNfOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (arithPolyNfOf (Mk (@/_total (Args t (Args d (Empty)))))) s))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) false)
   (arithPolyNfOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((atomPolyN-demand (Mk (@/_total (Args t (Args d (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (arithPolyNfOf d) pd)
   (= (polyIsConstN pd) true)
   (= (polyConstN pd) rat_zero)
   (arithPolyNfOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((atomPolyN-demand (Mk (@/_total (Args t (Args d (Empty)))))))
  :ruleset arith_poly)

(rule
  ((= (atomPolyN (Mk (@/_total (Args t (Args d (Empty)))))) p)
   (= (arithPolyNfOf d) pd)
   (arithPolyNfOf-demand (Mk (@/_total (Args t (Args d (Empty))))))
   (!= d (Empty)))
  ((set (arithPolyNfOf (Mk (@/_total (Args t (Args d (Empty)))))) p))
  :ruleset arith_poly)
